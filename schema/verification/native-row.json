{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://modelplan.ai/schema/verification/native-row.json",
  "$comment": "SPDX-License-Identifier: MIT. U6 verification receipt contract (C2.4); see README.md.",
  "title": "U6 native row envelope",
  "description": "Every native row is one flat object: this envelope plus the fields of its kind schema (x-kinds). A row whose kind is not listed is validated by the envelope only and never satisfies a step.",
  "x-file": "native-observations.jsonl (one JSON object per line, written only by U6DriveGuard.emitObject)",
  "x-kinds": {
    "started": "native/started.json",
    "doctor": "native/doctor.json",
    "dock-surface-frame": "native/dock-surface-frame.json",
    "status-item-frame": "native/status-item-frame.json",
    "menu-begin": "native/menu-begin.json",
    "menu-end": "native/menu-end.json",
    "menu-private-title-visible": "native/menu-private-title-visible.json",
    "status-menu-action-arrived": "native/status-menu-action-arrived.json",
    "refresh": "native/refresh.json",
    "clear-initiated": "native/clear-initiated.json",
    "accepted-clear": "native/accepted-clear.json",
    "menu-scrubbed": "native/menu-scrubbed.json",
    "stop-or-lease-expired": "native/stop.json",
    "owner-preempted": "native/stop.json",
    "terminate-completed": "native/terminate-completed.json"
  },
  "type": "object",
  "required": [
    "runID",
    "epoch",
    "pid",
    "seq",
    "mono",
    "at",
    "kind"
  ],
  "properties": {
    "runID": {
      "$ref": "common.json#/$defs/runID"
    },
    "epoch": {
      "$ref": "common.json#/$defs/epoch"
    },
    "pid": {
      "$ref": "common.json#/$defs/pid"
    },
    "seq": {
      "$ref": "common.json#/$defs/seq"
    },
    "mono": {
      "$ref": "common.json#/$defs/mono"
    },
    "at": {
      "$ref": "common.json#/$defs/at"
    },
    "kind": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,63}$"
    }
  },
  "additionalProperties": true
}
