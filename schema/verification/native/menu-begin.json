{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://modelplan.ai/schema/verification/native/menu-begin.json",
  "$comment": "SPDX-License-Identifier: MIT. U6 verification receipt contract (C2.4 as amended by C2.6); see README.md.",
  "title": "menu-begin",
  "description": "NSMenu didBeginTracking for an owned menu. Each begin mints a fresh sessionID; menuObjectID is the reused production menu object.",
  "type": "object",
  "required": [
    "runID",
    "epoch",
    "pid",
    "seq",
    "mono",
    "at",
    "event",
    "timestamp",
    "checks"
  ],
  "properties": {
    "runID": {
      "$ref": "../common.json#/$defs/runID"
    },
    "epoch": {
      "$ref": "../common.json#/$defs/epoch"
    },
    "pid": {
      "$ref": "../common.json#/$defs/pid"
    },
    "seq": {
      "$ref": "../common.json#/$defs/seq"
    },
    "mono": {
      "$ref": "../common.json#/$defs/mono"
    },
    "at": {
      "$ref": "../common.json#/$defs/at"
    },
    "event": {
      "const": "menu-begin"
    },
    "timestamp": {
      "$ref": "../common.json#/$defs/timestamp"
    },
    "checks": {
      "type": "object",
      "required": [
        "menuObjectID",
        "sessionID",
        "surface",
        "privateContent"
      ],
      "properties": {
        "menuObjectID": {
          "$ref": "../common.json#/$defs/objectID"
        },
        "sessionID": {
          "$ref": "../common.json#/$defs/uuid"
        },
        "surface": {
          "enum": [
            "status",
            "dock"
          ]
        },
        "privateContent": {
          "type": "boolean"
        },
        "instanceID": {
          "$ref": "../common.json#/$defs/objectID"
        },
        "subjectPID": {
          "$ref": "../common.json#/$defs/pid"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
