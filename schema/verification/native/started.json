{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://modelplan.ai/schema/verification/native/started.json",
  "$comment": "SPDX-License-Identifier: MIT. U6 verification receipt contract (C2.4 as amended by C2.6); see README.md.",
  "title": "started",
  "description": "First row of the subject; declares the native protocol version. Drive waits for it (bounded) before actions.",
  "type": "object",
  "required": [
    "runID",
    "epoch",
    "pid",
    "seq",
    "mono",
    "at",
    "event",
    "timestamp",
    "checks"
  ],
  "properties": {
    "runID": {
      "$ref": "../common.json#/$defs/runID"
    },
    "epoch": {
      "$ref": "../common.json#/$defs/epoch"
    },
    "pid": {
      "$ref": "../common.json#/$defs/pid"
    },
    "seq": {
      "$ref": "../common.json#/$defs/seq"
    },
    "mono": {
      "$ref": "../common.json#/$defs/mono"
    },
    "at": {
      "$ref": "../common.json#/$defs/at"
    },
    "event": {
      "const": "started"
    },
    "timestamp": {
      "$ref": "../common.json#/$defs/timestamp"
    },
    "checks": {
      "type": "object",
      "required": [],
      "properties": {
        "protocol": {
          "type": "string",
          "pattern": "^u6-native/[1-9][0-9]*$",
          "description": "Absent in the App today, which means u6-native/1; any other version is unsupported (C2.6 F: NOT-RUN unknown)."
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
