{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://modelplan.ai/schema/verification/native/accepted-clear.json",
  "$comment": "SPDX-License-Identifier: MIT. U6 verification receipt contract (C2.4 as amended by C2.6); see README.md.",
  "title": "accepted-clear",
  "description": "The app accepted the clear named by clearID; scrubbedSessionIDs lists sessions whose recorded private items are all deallocated or cleared.",
  "type": "object",
  "required": [
    "runID",
    "epoch",
    "pid",
    "seq",
    "mono",
    "at",
    "event",
    "timestamp",
    "checks"
  ],
  "properties": {
    "runID": {
      "$ref": "../common.json#/$defs/runID"
    },
    "epoch": {
      "$ref": "../common.json#/$defs/epoch"
    },
    "pid": {
      "$ref": "../common.json#/$defs/pid"
    },
    "seq": {
      "$ref": "../common.json#/$defs/seq"
    },
    "mono": {
      "$ref": "../common.json#/$defs/mono"
    },
    "at": {
      "$ref": "../common.json#/$defs/at"
    },
    "event": {
      "const": "accepted-clear"
    },
    "timestamp": {
      "$ref": "../common.json#/$defs/timestamp"
    },
    "checks": {
      "type": "object",
      "required": [
        "clearID",
        "storeEpochAfter",
        "generationAfter",
        "scrubbedSessionIDs",
        "priorPrivateContent",
        "trackingClosed"
      ],
      "properties": {
        "clearID": {
          "$ref": "../common.json#/$defs/uuid"
        },
        "storeEpochAfter": {
          "$ref": "../common.json#/$defs/storeEpoch"
        },
        "generationAfter": {
          "$ref": "../common.json#/$defs/generation"
        },
        "scrubbedSessionIDs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "../common.json#/$defs/uuid"
          }
        },
        "priorPrivateContent": {
          "type": "boolean"
        },
        "trackingClosed": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
