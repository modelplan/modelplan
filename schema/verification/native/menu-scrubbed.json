{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://modelplan.ai/schema/verification/native/menu-scrubbed.json",
  "$comment": "SPDX-License-Identifier: MIT. U6 verification receipt contract (C2.4); see README.md.",
  "title": "menu-scrubbed",
  "description": "Per open session of a clear: the state of every recorded private item (weak reference) plus a walk of the current menu items for the private title hash.",
  "type": "object",
  "required": [
    "runID",
    "epoch",
    "pid",
    "seq",
    "mono",
    "at",
    "kind",
    "clearID",
    "sessionID",
    "menuObjectID",
    "privateTitlePresent",
    "privateAttributeCount",
    "itemStates"
  ],
  "properties": {
    "runID": {
      "$ref": "../common.json#/$defs/runID"
    },
    "epoch": {
      "$ref": "../common.json#/$defs/epoch"
    },
    "pid": {
      "$ref": "../common.json#/$defs/pid"
    },
    "seq": {
      "$ref": "../common.json#/$defs/seq"
    },
    "mono": {
      "$ref": "../common.json#/$defs/mono"
    },
    "at": {
      "$ref": "../common.json#/$defs/at"
    },
    "kind": {
      "const": "menu-scrubbed"
    },
    "clearID": {
      "$ref": "../common.json#/$defs/uuid"
    },
    "sessionID": {
      "$ref": "../common.json#/$defs/uuid"
    },
    "menuObjectID": {
      "$ref": "../common.json#/$defs/objectID"
    },
    "privateTitlePresent": {
      "type": "boolean"
    },
    "privateAttributeCount": {
      "type": "integer",
      "minimum": 0
    },
    "itemStates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "state"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "$ref": "../common.json#/$defs/objectID"
          },
          "state": {
            "enum": [
              "deallocated",
              "cleared",
              "private"
            ]
          }
        }
      }
    }
  },
  "additionalProperties": false
}
