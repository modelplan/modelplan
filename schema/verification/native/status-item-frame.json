{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://modelplan.ai/schema/verification/native/status-item-frame.json",
  "$comment": "SPDX-License-Identifier: MIT. U6 verification receipt contract (C2.4 as amended by C2.6); see README.md.",
  "title": "status-item-frame",
  "description": "Owned status item button frame (AppKit screen space plus cgX/cgY); the pointer plan clicks its centre.",
  "type": "object",
  "required": [
    "runID",
    "epoch",
    "pid",
    "seq",
    "mono",
    "at",
    "event",
    "timestamp",
    "checks"
  ],
  "properties": {
    "runID": {
      "$ref": "../common.json#/$defs/runID"
    },
    "epoch": {
      "$ref": "../common.json#/$defs/epoch"
    },
    "pid": {
      "$ref": "../common.json#/$defs/pid"
    },
    "seq": {
      "$ref": "../common.json#/$defs/seq"
    },
    "mono": {
      "$ref": "../common.json#/$defs/mono"
    },
    "at": {
      "$ref": "../common.json#/$defs/at"
    },
    "event": {
      "const": "status-item-frame"
    },
    "timestamp": {
      "$ref": "../common.json#/$defs/timestamp"
    },
    "checks": {
      "type": "object",
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "width": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "height": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "coordinateSpace": {
          "const": "appkit-screen"
        },
        "cgX": {
          "type": "number"
        },
        "cgY": {
          "type": "number"
        },
        "settled": {
          "type": "boolean"
        },
        "stableSinceMono": {
          "type": "number",
          "minimum": 0
        },
        "displayBounds": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "type": "number"
          }
        },
        "menuBarBand": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "type": "number"
          }
        },
        "frameGeneration": {
          "type": "integer",
          "minimum": 1
        },
        "windowNumber": {
          "type": "integer",
          "minimum": 0
        },
        "visible": {
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "not": {
              "required": [
                "frameGeneration"
              ]
            }
          },
          "then": {
            "required": [
              "x",
              "y",
              "width",
              "height",
              "coordinateSpace",
              "cgX",
              "cgY"
            ]
          }
        },
        {
          "if": {
            "required": [
              "frameGeneration"
            ]
          },
          "then": {
            "required": [
              "windowNumber",
              "visible",
              "settled"
            ]
          }
        },
        {
          "if": {
            "required": [
              "settled"
            ],
            "properties": {
              "settled": {
                "const": true
              }
            }
          },
          "then": {
            "required": [
              "x",
              "y",
              "width",
              "height",
              "coordinateSpace",
              "cgX",
              "cgY",
              "stableSinceMono",
              "displayBounds",
              "menuBarBand"
            ]
          }
        },
        {
          "if": {
            "required": [
              "frameGeneration",
              "settled"
            ],
            "properties": {
              "settled": {
                "const": true
              }
            }
          },
          "then": {
            "properties": {
              "visible": {
                "const": true
              },
              "windowNumber": {
                "minimum": 1
              }
            }
          }
        }
      ]
    }
  },
  "additionalProperties": false
}
