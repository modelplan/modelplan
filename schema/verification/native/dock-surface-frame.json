{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://modelplan.ai/schema/verification/native/dock-surface-frame.json",
  "$comment": "SPDX-License-Identifier: MIT. U6 verification receipt contract (C2.4); see README.md.",
  "title": "dock-surface-frame",
  "description": "Owned Dock panel painted frame in CG screen space; emitted on change. Step 1 needs state expanded.",
  "type": "object",
  "required": [
    "runID",
    "epoch",
    "pid",
    "seq",
    "mono",
    "at",
    "kind",
    "state",
    "windowNumber",
    "x",
    "y",
    "width",
    "height",
    "coordinateSpace"
  ],
  "properties": {
    "runID": {
      "$ref": "../common.json#/$defs/runID"
    },
    "epoch": {
      "$ref": "../common.json#/$defs/epoch"
    },
    "pid": {
      "$ref": "../common.json#/$defs/pid"
    },
    "seq": {
      "$ref": "../common.json#/$defs/seq"
    },
    "mono": {
      "$ref": "../common.json#/$defs/mono"
    },
    "at": {
      "$ref": "../common.json#/$defs/at"
    },
    "kind": {
      "const": "dock-surface-frame"
    },
    "state": {
      "enum": [
        "sliver",
        "expanded"
      ]
    },
    "windowNumber": {
      "type": "integer",
      "minimum": 1
    },
    "x": {
      "type": "number"
    },
    "y": {
      "type": "number"
    },
    "width": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "height": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "coordinateSpace": {
      "const": "cg-screen"
    }
  },
  "additionalProperties": false
}
