{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://modelplan.ai/schema/verification/native/refresh.json",
  "$comment": "SPDX-License-Identifier: MIT. U6 verification receipt contract (C2.4); see README.md.",
  "title": "refresh",
  "description": "Production Refresh handler rows for one request: requested (written by the handler), then exactly one terminal (completed or failed).",
  "type": "object",
  "required": [
    "runID",
    "epoch",
    "pid",
    "seq",
    "mono",
    "at",
    "kind",
    "phase",
    "requestId",
    "menuObjectID",
    "sessionID"
  ],
  "properties": {
    "runID": {
      "$ref": "../common.json#/$defs/runID"
    },
    "epoch": {
      "$ref": "../common.json#/$defs/epoch"
    },
    "pid": {
      "$ref": "../common.json#/$defs/pid"
    },
    "seq": {
      "$ref": "../common.json#/$defs/seq"
    },
    "mono": {
      "$ref": "../common.json#/$defs/mono"
    },
    "at": {
      "$ref": "../common.json#/$defs/at"
    },
    "kind": {
      "const": "refresh"
    },
    "phase": {
      "enum": [
        "requested",
        "completed",
        "failed"
      ]
    },
    "requestId": {
      "$ref": "../common.json#/$defs/uuid"
    },
    "menuObjectID": {
      "$ref": "../common.json#/$defs/objectID"
    },
    "sessionID": {
      "$ref": "../common.json#/$defs/uuid"
    },
    "rowsSequenceBefore": {
      "type": "integer",
      "minimum": 0
    },
    "rowsSequenceAfter": {
      "type": "integer",
      "minimum": 0
    },
    "reason": {
      "$ref": "../common.json#/$defs/scenarioReason"
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "phase": {
            "const": "requested"
          }
        }
      },
      "then": {
        "required": [
          "rowsSequenceBefore"
        ],
        "not": {
          "anyOf": [
            {
              "required": [
                "rowsSequenceAfter"
              ]
            },
            {
              "required": [
                "reason"
              ]
            }
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "phase": {
            "const": "completed"
          }
        }
      },
      "then": {
        "required": [
          "rowsSequenceAfter"
        ],
        "not": {
          "anyOf": [
            {
              "required": [
                "rowsSequenceBefore"
              ]
            },
            {
              "required": [
                "reason"
              ]
            }
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "phase": {
            "const": "failed"
          }
        }
      },
      "then": {
        "required": [
          "reason"
        ],
        "not": {
          "anyOf": [
            {
              "required": [
                "rowsSequenceBefore"
              ]
            },
            {
              "required": [
                "rowsSequenceAfter"
              ]
            }
          ]
        }
      }
    }
  ]
}
