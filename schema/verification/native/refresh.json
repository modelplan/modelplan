{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://modelplan.ai/schema/verification/native/refresh.json",
  "$comment": "SPDX-License-Identifier: MIT. U6 verification receipt contract (C2.4 as amended by C2.5); see README.md.",
  "title": "refresh",
  "description": "Production Refresh handler rows for one request, written flat (C2.5 F): requested (with the engine's per-scope dispositions and whether the Copilot row exists), then exactly one terminal: completed (copilotRow after), failed (production result), deferred (Copilot not scheduled) or abandoned (watchdog: deadline or stop) (C2.5 D).",
  "type": "object",
  "required": [
    "runID",
    "epoch",
    "pid",
    "seq",
    "mono",
    "at",
    "kind",
    "phase",
    "requestId",
    "menuObjectID",
    "sessionID"
  ],
  "properties": {
    "runID": {
      "$ref": "../common.json#/$defs/runID"
    },
    "epoch": {
      "$ref": "../common.json#/$defs/epoch"
    },
    "pid": {
      "$ref": "../common.json#/$defs/pid"
    },
    "seq": {
      "$ref": "../common.json#/$defs/seq"
    },
    "mono": {
      "$ref": "../common.json#/$defs/mono"
    },
    "at": {
      "$ref": "../common.json#/$defs/at"
    },
    "kind": {
      "const": "refresh"
    },
    "phase": {
      "enum": [
        "requested",
        "completed",
        "failed",
        "deferred",
        "abandoned"
      ]
    },
    "requestId": {
      "$ref": "../common.json#/$defs/uuid"
    },
    "menuObjectID": {
      "$ref": "../common.json#/$defs/objectID"
    },
    "sessionID": {
      "$ref": "../common.json#/$defs/uuid"
    },
    "rowsSequenceBefore": {
      "type": "integer",
      "minimum": 0
    },
    "rowsSequenceAfter": {
      "type": "integer",
      "minimum": 0
    },
    "reason": {
      "$ref": "../common.json#/$defs/scenarioReason"
    },
    "dispositions": {
      "type": "object",
      "required": [
        "copilot.runtime_usage"
      ],
      "properties": {
        "copilot.runtime_usage": {
          "$ref": "../common.json#/$defs/disposition"
        }
      },
      "additionalProperties": {
        "$ref": "../common.json#/$defs/disposition"
      }
    },
    "copilotRow": {
      "enum": [
        "absent",
        "present"
      ]
    },
    "cause": {
      "enum": [
        "deadline",
        "stop"
      ]
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "phase": {
            "const": "requested"
          }
        }
      },
      "then": {
        "required": [
          "rowsSequenceBefore",
          "dispositions",
          "copilotRow"
        ],
        "not": {
          "anyOf": [
            {
              "required": [
                "rowsSequenceAfter"
              ]
            },
            {
              "required": [
                "reason"
              ]
            },
            {
              "required": [
                "cause"
              ]
            }
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "phase": {
            "const": "completed"
          }
        }
      },
      "then": {
        "required": [
          "rowsSequenceAfter",
          "copilotRow"
        ],
        "not": {
          "anyOf": [
            {
              "required": [
                "rowsSequenceBefore"
              ]
            },
            {
              "required": [
                "reason"
              ]
            },
            {
              "required": [
                "dispositions"
              ]
            },
            {
              "required": [
                "cause"
              ]
            }
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "phase": {
            "const": "failed"
          }
        }
      },
      "then": {
        "required": [
          "reason"
        ],
        "not": {
          "anyOf": [
            {
              "required": [
                "rowsSequenceBefore"
              ]
            },
            {
              "required": [
                "rowsSequenceAfter"
              ]
            },
            {
              "required": [
                "dispositions"
              ]
            },
            {
              "required": [
                "copilotRow"
              ]
            },
            {
              "required": [
                "cause"
              ]
            }
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "phase": {
            "const": "deferred"
          }
        }
      },
      "then": {
        "required": [],
        "not": {
          "anyOf": [
            {
              "required": [
                "rowsSequenceBefore"
              ]
            },
            {
              "required": [
                "rowsSequenceAfter"
              ]
            },
            {
              "required": [
                "reason"
              ]
            },
            {
              "required": [
                "dispositions"
              ]
            },
            {
              "required": [
                "copilotRow"
              ]
            },
            {
              "required": [
                "cause"
              ]
            }
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "phase": {
            "const": "abandoned"
          }
        }
      },
      "then": {
        "required": [
          "cause"
        ],
        "not": {
          "anyOf": [
            {
              "required": [
                "rowsSequenceBefore"
              ]
            },
            {
              "required": [
                "rowsSequenceAfter"
              ]
            },
            {
              "required": [
                "reason"
              ]
            },
            {
              "required": [
                "dispositions"
              ]
            },
            {
              "required": [
                "copilotRow"
              ]
            }
          ]
        }
      }
    }
  ]
}
