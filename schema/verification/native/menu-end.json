{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://modelplan.ai/schema/verification/native/menu-end.json",
  "$comment": "SPDX-License-Identifier: MIT. U6 verification receipt contract (C2.4 as amended by C2.5); see README.md.",
  "title": "menu-end",
  "description": "NSMenu didEndTracking. cause is clear only for a session open at clear-initiated, with that clearID.",
  "type": "object",
  "required": [
    "runID",
    "epoch",
    "pid",
    "seq",
    "mono",
    "at",
    "event",
    "timestamp",
    "checks"
  ],
  "properties": {
    "runID": {
      "$ref": "../common.json#/$defs/runID"
    },
    "epoch": {
      "$ref": "../common.json#/$defs/epoch"
    },
    "pid": {
      "$ref": "../common.json#/$defs/pid"
    },
    "seq": {
      "$ref": "../common.json#/$defs/seq"
    },
    "mono": {
      "$ref": "../common.json#/$defs/mono"
    },
    "at": {
      "$ref": "../common.json#/$defs/at"
    },
    "event": {
      "const": "menu-end"
    },
    "timestamp": {
      "$ref": "../common.json#/$defs/timestamp"
    },
    "checks": {
      "type": "object",
      "required": [
        "menuObjectID",
        "sessionID",
        "cause"
      ],
      "properties": {
        "menuObjectID": {
          "$ref": "../common.json#/$defs/objectID"
        },
        "sessionID": {
          "$ref": "../common.json#/$defs/uuid"
        },
        "cause": {
          "enum": [
            "clear",
            "other"
          ]
        },
        "clearID": {
          "$ref": "../common.json#/$defs/uuid"
        },
        "instanceID": {
          "$ref": "../common.json#/$defs/objectID"
        }
      },
      "additionalProperties": false,
      "if": {
        "properties": {
          "cause": {
            "const": "clear"
          }
        }
      },
      "then": {
        "required": [
          "clearID"
        ]
      },
      "else": {
        "not": {
          "required": [
            "clearID"
          ]
        }
      }
    }
  },
  "additionalProperties": false
}
