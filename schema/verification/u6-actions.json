{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://modelplan.ai/schema/verification/u6-actions.json",
  "$comment": "SPDX-License-Identifier: MIT. U6 verification receipt contract (C2.4 as amended by C2.6); see README.md.",
  "title": "u6-actions/1",
  "description": "Action runner hand-off: the runner's per-step action outcome for steps 1-6 (dock, menuA, refresh, menuB, privateTitle, trackedClear) plus its run outcome and bounded reason. It is a claim, never proof: a non-pass entry fails or skips step 7, a pass entry proves nothing.",
  "x-file": "operator-finish.json (action runner, exclusive create, once)",
  "type": "object",
  "required": [
    "schema",
    "runID",
    "epoch",
    "mono",
    "steps",
    "outcome",
    "reason"
  ],
  "properties": {
    "schema": {
      "const": "u6-actions/1"
    },
    "runID": {
      "$ref": "common.json#/$defs/runID"
    },
    "epoch": {
      "$ref": "common.json#/$defs/epoch"
    },
    "pid": {
      "$ref": "common.json#/$defs/pid"
    },
    "mono": {
      "$ref": "common.json#/$defs/mono"
    },
    "at": {
      "$ref": "common.json#/$defs/at"
    },
    "steps": {
      "type": "object",
      "required": [
        "dock",
        "menuA",
        "refresh",
        "menuB",
        "privateTitle",
        "trackedClear"
      ],
      "properties": {
        "dock": {
          "$ref": "common.json#/$defs/stepOutcome"
        },
        "menuA": {
          "$ref": "common.json#/$defs/stepOutcome"
        },
        "refresh": {
          "$ref": "common.json#/$defs/stepOutcome"
        },
        "menuB": {
          "$ref": "common.json#/$defs/stepOutcome"
        },
        "privateTitle": {
          "$ref": "common.json#/$defs/stepOutcome"
        },
        "trackedClear": {
          "$ref": "common.json#/$defs/stepOutcome"
        }
      },
      "additionalProperties": false
    },
    "outcome": {
      "$ref": "common.json#/$defs/stepOutcome"
    },
    "reason": {
      "anyOf": [
        {
          "$ref": "common.json#/$defs/scenarioReason"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "additionalProperties": false,
  "x-producer": "desktop/native/verification/U6/action_runner.py"
}
