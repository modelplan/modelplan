{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://modelplan.ai/schema/app-cli/doctor-readers.json",
  "$comment": "SPDX-License-Identifier: MIT. App\u2013CLI contract; generated fixtures come from the real binary.",
  "x-behavior": {
    "backgroundRefresh": "never",
    "credentials": "none; presence/cache metadata only",
    "network": "none",
    "writes": "none",
    "exitCodes": {
      "0": "successful JSON object",
      "1": "unavailable; JSON error for consent, stderr/empty output for other commands",
      "2": "usage on stderr"
    },
    "displayText": "notice, nextStep, names, messages, and legacy hosts are display only",
    "refresh": "--refresh is an explicit foreground action; may read admitted providers and use interactive Keychain policy, sharing existing floors and budgets"
  },
  "type": "object",
  "properties": {
    "readers": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "provider": {
            "type": "string",
            "description": "Machine value; not display text."
          },
          "detected": {
            "type": "string",
            "description": "Machine value; not display text.",
            "enum": [
              "yes",
              "no"
            ]
          },
          "consent": {
            "type": "string",
            "description": "Machine value; not display text.",
            "enum": [
              "none",
              "granted",
              "denied"
            ]
          },
          "admitted": {
            "type": "string",
            "description": "Machine value; not display text.",
            "enum": [
              "yes",
              "no"
            ]
          },
          "state": {
            "type": "string",
            "description": "Machine diagnostic state; native failure is unavailable:reader_error:<sanitised error code>, never raw error text."
          },
          "windows": {
            "type": "integer",
            "minimum": 0
          },
          "last": {
            "type": "string",
            "description": "Machine value; not display text.",
            "pattern": "^(unknown|[0-9]+s)$"
          },
          "beta": {
            "type": "boolean"
          },
          "cause": {
            "type": "string",
            "description": "Fixed failure code behind a failed state (reader_error:<code> or runtime_missing); absent otherwise."
          },
          "failures": {
            "type": "array",
            "description": "Codex only: the last 10 failed reads, oldest first. Fixed codes and times only.",
            "maxItems": 10,
            "items": {
              "type": "object",
              "properties": {
                "code": { "type": "string" },
                "at": { "type": "string", "format": "date-time" },
                "streakSeconds": { "type": "integer", "minimum": 0 }
              },
              "required": ["code", "at", "streakSeconds"],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "provider",
          "detected",
          "consent",
          "admitted",
          "state",
          "windows",
          "last",
          "beta"
        ],
        "additionalProperties": true
      }
    },
    "message": {
      "type": "string",
      "description": "Display text only; never parse as an endpoint or permission."
    },
    "consentStore": {
      "const": "consent_store_unreadable"
    }
  },
  "required": [
    "readers",
    "message"
  ],
  "additionalProperties": true
}
