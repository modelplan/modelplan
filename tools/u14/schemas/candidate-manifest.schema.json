{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "U14 candidate-manifest v1",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "candidateId": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,99}$"
    },
    "profile": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,99}$"
    },
    "intendedLevel": {
      "type": "string",
      "enum": [
        "L1",
        "L2",
        "L3"
      ]
    },
    "generatedAt": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "build": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "community",
            "official"
          ]
        },
        "configuration": {
          "type": "string",
          "enum": [
            "debug",
            "release"
          ]
        }
      },
      "required": [
        "type",
        "configuration"
      ],
      "additionalProperties": false
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "repository": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "sha": {
            "type": "string",
            "pattern": "^[a-f0-9]{40,64}$"
          },
          "dirty": {
            "const": false
          }
        },
        "required": [
          "repository",
          "sha",
          "dirty"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 1000
    },
    "artifacts": {
      "type": "object",
      "properties": {
        "app": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "state": {
                  "const": "unsupported"
                }
              },
              "required": [
                "state"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "state": {
                  "const": "available"
                },
                "kind": {
                  "type": "string",
                  "enum": [
                    "file",
                    "tree"
                  ]
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              },
              "required": [
                "state",
                "kind",
                "sha256"
              ],
              "additionalProperties": false
            }
          ]
        },
        "helper": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "state": {
                  "const": "unsupported"
                }
              },
              "required": [
                "state"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "state": {
                  "const": "available"
                },
                "kind": {
                  "type": "string",
                  "enum": [
                    "file",
                    "tree"
                  ]
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              },
              "required": [
                "state",
                "kind",
                "sha256"
              ],
              "additionalProperties": false
            }
          ]
        },
        "helperVersion": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            },
            {
              "type": "null"
            }
          ]
        },
        "officialVisualsManifest": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "state": {
                  "const": "unsupported"
                }
              },
              "required": [
                "state"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "state": {
                  "const": "available"
                },
                "kind": {
                  "type": "string",
                  "enum": [
                    "file",
                    "tree"
                  ]
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              },
              "required": [
                "state",
                "kind",
                "sha256"
              ],
              "additionalProperties": false
            }
          ]
        },
        "visualBaselines": {
          "type": "array",
          "items": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "state": {
                    "const": "unsupported"
                  }
                },
                "required": [
                  "state"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "state": {
                    "const": "available"
                  },
                  "kind": {
                    "type": "string",
                    "enum": [
                      "file",
                      "tree"
                    ]
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  }
                },
                "required": [
                  "state",
                  "kind",
                  "sha256"
                ],
                "additionalProperties": false
              }
            ]
          },
          "minItems": 0,
          "maxItems": 1000
        }
      },
      "required": [
        "app",
        "helper",
        "helperVersion",
        "officialVisualsManifest",
        "visualBaselines"
      ],
      "additionalProperties": false
    },
    "publicationData": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "state": {
              "const": "unsupported"
            }
          },
          "required": [
            "state"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "state": {
              "const": "available"
            },
            "revision": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            }
          },
          "required": [
            "state",
            "revision"
          ],
          "additionalProperties": false
        }
      ]
    },
    "environment": {
      "type": "object",
      "properties": {
        "os": {
          "type": "object",
          "properties": {
            "system": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            },
            "release": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            },
            "version": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            },
            "machine": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            }
          },
          "required": [
            "system",
            "release",
            "version",
            "machine"
          ],
          "additionalProperties": false
        },
        "display": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "state": {
                  "const": "unsupported"
                }
              },
              "required": [
                "state"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "state": {
                  "const": "available"
                },
                "width": {
                  "type": "integer",
                  "minimum": 1
                },
                "height": {
                  "type": "integer",
                  "minimum": 1
                },
                "scale": {
                  "type": "number",
                  "minimum": 0.1
                },
                "theme": {
                  "type": "string",
                  "enum": [
                    "light",
                    "dark"
                  ]
                },
                "locale": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 500
                }
              },
              "required": [
                "state",
                "width",
                "height",
                "scale",
                "theme",
                "locale"
              ],
              "additionalProperties": false
            }
          ]
        }
      },
      "required": [
        "os",
        "display"
      ],
      "additionalProperties": false
    },
    "shapeBaseline": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "baselineVersion": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,99}$"
        },
        "shapeSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "fidelity": {
          "type": "string",
          "enum": [
            "hand-built",
            "approved-shape-export"
          ]
        },
        "approvalRef": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            },
            {
              "type": "null"
            }
          ]
        },
        "preferenceCase": {
          "type": "string",
          "enum": [
            "coexistence",
            "corrupt-beta07",
            "missing-beta07",
            "corrupt-native",
            "corrupt-core",
            "all-corrupt",
            "fresh",
            "new-exists",
            "corrupt-new"
          ]
        },
        "covers": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "minItems": 0,
          "maxItems": 1000,
          "uniqueItems": true
        },
        "knownGaps": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "minItems": 1,
          "maxItems": 1000
        },
        "availableCapabilities": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "minItems": 0,
          "maxItems": 1000,
          "uniqueItems": true
        },
        "migrationOracle": {
          "type": "object",
          "properties": {
            "officialSettingsSource": {
              "type": "string",
              "enum": [
                "beta07",
                "native",
                "new",
                "defaults"
              ]
            },
            "communitySettingsSource": {
              "type": "string",
              "enum": [
                "beta07",
                "native",
                "new",
                "defaults"
              ]
            },
            "coreSource": {
              "type": "string",
              "enum": [
                "core",
                "new",
                "defaults"
              ]
            }
          },
          "required": [
            "officialSettingsSource",
            "communitySettingsSource",
            "coreSource"
          ],
          "additionalProperties": false
        },
        "files": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            },
            "required": [
              "path",
              "sha256"
            ],
            "additionalProperties": false
          },
          "minItems": 0,
          "maxItems": 1000
        }
      },
      "required": [
        "schemaVersion",
        "baselineVersion",
        "shapeSha256",
        "fidelity",
        "approvalRef",
        "preferenceCase",
        "covers",
        "knownGaps",
        "availableCapabilities",
        "migrationOracle",
        "files"
      ],
      "additionalProperties": false,
      "anyOf": [
        {
          "properties": {
            "fidelity": {
              "const": "hand-built"
            },
            "approvalRef": {
              "type": "null"
            }
          }
        },
        {
          "properties": {
            "fidelity": {
              "const": "approved-shape-export"
            },
            "approvalRef": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    },
    "availableCapabilities": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500
      },
      "minItems": 0,
      "maxItems": 1000,
      "uniqueItems": true
    },
    "scenarioCatalogSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "scenarios": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "outcome": {
            "type": "string",
            "enum": [
              "pass",
              "fail",
              "not-run",
              "unsupported",
              "timeout"
            ]
          },
          "missingCapabilities": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            },
            "minItems": 0,
            "maxItems": 1000,
            "uniqueItems": true
          },
          "missingStructures": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            },
            "minItems": 0,
            "maxItems": 1000,
            "uniqueItems": true
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "ref": {
                  "type": "string",
                  "pattern": "^blobs/[a-f0-9]{64}$"
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              },
              "required": [
                "ref",
                "sha256"
              ],
              "additionalProperties": false
            },
            "minItems": 0,
            "maxItems": 1000
          }
        },
        "required": [
          "id",
          "outcome",
          "missingCapabilities",
          "missingStructures",
          "evidence"
        ],
        "additionalProperties": false
      },
      "minItems": 21,
      "maxItems": 21
    },
    "bundleFiles": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "ref": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "ref",
          "sha256"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 1000
    }
  },
  "required": [
    "schemaVersion",
    "candidateId",
    "profile",
    "intendedLevel",
    "generatedAt",
    "build",
    "sources",
    "artifacts",
    "publicationData",
    "environment",
    "shapeBaseline",
    "availableCapabilities",
    "scenarioCatalogSha256",
    "scenarios",
    "bundleFiles"
  ],
  "additionalProperties": false
}
