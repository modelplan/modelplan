{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "U14 candidate-input v1",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "candidateId": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,99}$"
    },
    "profile": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,99}$"
    },
    "intendedLevel": {
      "type": "string",
      "enum": [
        "L1",
        "L2",
        "L3"
      ]
    },
    "build": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "community",
            "official"
          ]
        },
        "configuration": {
          "type": "string",
          "enum": [
            "debug",
            "release"
          ]
        }
      },
      "required": [
        "type",
        "configuration"
      ],
      "additionalProperties": false
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "repository": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        },
        "required": [
          "repository",
          "path"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 1000
    },
    "artifacts": {
      "type": "object",
      "properties": {
        "app": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            },
            {
              "type": "null"
            }
          ]
        },
        "helper": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            },
            {
              "type": "null"
            }
          ]
        },
        "helperVersion": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            },
            {
              "type": "null"
            }
          ]
        },
        "officialVisualsManifest": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            },
            {
              "type": "null"
            }
          ]
        },
        "visualBaselines": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "minItems": 0,
          "maxItems": 1000
        }
      },
      "required": [
        "app",
        "helper",
        "helperVersion",
        "officialVisualsManifest",
        "visualBaselines"
      ],
      "additionalProperties": false
    },
    "publicationRevision": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        {
          "type": "null"
        }
      ]
    },
    "display": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "state": {
              "const": "unsupported"
            }
          },
          "required": [
            "state"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "state": {
              "const": "available"
            },
            "width": {
              "type": "integer",
              "minimum": 1
            },
            "height": {
              "type": "integer",
              "minimum": 1
            },
            "scale": {
              "type": "number",
              "minimum": 0.1
            },
            "theme": {
              "type": "string",
              "enum": [
                "light",
                "dark"
              ]
            },
            "locale": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            }
          },
          "required": [
            "state",
            "width",
            "height",
            "scale",
            "theme",
            "locale"
          ],
          "additionalProperties": false
        }
      ]
    },
    "availableCapabilities": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500
      },
      "minItems": 0,
      "maxItems": 1000,
      "uniqueItems": true
    },
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "outcome": {
            "type": "string",
            "enum": [
              "pass",
              "fail",
              "not-run",
              "unsupported",
              "timeout"
            ]
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            },
            "minItems": 0,
            "maxItems": 1000
          }
        },
        "required": [
          "id",
          "outcome",
          "evidence"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 1000
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "outcome": {
            "type": "string",
            "enum": [
              "pass",
              "fail",
              "not-run",
              "unsupported",
              "timeout"
            ]
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            },
            "minItems": 0,
            "maxItems": 1000
          }
        },
        "required": [
          "id",
          "outcome",
          "evidence"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 1000
    }
  },
  "required": [
    "schemaVersion",
    "candidateId",
    "profile",
    "intendedLevel",
    "build",
    "sources",
    "artifacts",
    "publicationRevision",
    "display",
    "availableCapabilities",
    "results"
  ],
  "additionalProperties": false
}
