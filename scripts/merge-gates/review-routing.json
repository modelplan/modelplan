    { "area": "swift-go-seam", "re": "^desktop/native/Sources/ModelPlanCore/|^desktop/native/ModelPlan(EngineStore|EngineClient|CockpitWeb|CredentialAgent)/|^desktop/cockpit/src/bridge|(^|/)(AppServer[A-Za-z]*|Engine(Lifecycle|RowsEventDecoder|RowsEntry|AppCache|AccountMembers)[A-Za-z]*|[A-Za-z]*Bridge|[A-Za-z]*Transport)\\.swift$|^cli/cmd/modelplan/(app_|consent|connect|reader_|doctor_readers|native_refresh|plugin_install|update)" },
    { "area": "timing", "re": "deadline|fence|lifecycle|watchdog|supervis|schedul|cadence|observe_loop|refresh|lease|debounce|timer|SystemEvents|DisplayChangeRecheck|RunLoop|procgroup|(^|[/_])lock(ed)?(_[a-z]+)?\\.go$|(^|/)pipe_[a-z]+\\.go$" },
    { "area": "release", "re": "release|notari[sz]|codesign|signing|sparkle|cliupdate|(^|/)update\\.go$|install|(^|/)go\\.(mod|sum)$|(^|/)Package\\.resolved$|(^|/)package-lock\\.json$|\\.entitlements$|(^|/)Info\\.plist$" },
    { "area": "pins", "re": "-pin[^/]*$|(^|/)pins?\\.[a-z]+$" },
    { "area": "security", "re": "^\\.github/workflows/(merge-gates|pr-review|mac-compile)|^scripts/(merge-gates|pr-review|mac-compile)/|^desktop/native/verification/scenario-tiers\\.tsv$|sandbox|entitlement|permission|(^|/)SECURITY" }
