{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$PLUGIN_ROOT/hooks/modelplan-quota-hints.sh\"",
            "statusMessage": "ModelPlan: quota hints and task-start brief",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "compact|resume",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$PLUGIN_ROOT/hooks/session-start.sh\"",
            "statusMessage": "ModelPlan: quota notice after compaction or resume",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
