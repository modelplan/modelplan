{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "modelplan-codex",
  "version": "0.8.0",
  "description": "Read-only Codex GPT console: recommended efforts, your own quota and reset countdown (read locally), and public reset notices. Needs Node.js 22 or newer; finds one automatically when Codex has it.",
  "author": {
    "name": "Model Plan",
    "url": "https://github.com/modelplan/modelplan"
  },
  "homepage": "https://modelplan.ai/effort",
  "extensions": {
    "com.openai": {
      "interface": {
        "displayName": "ModelPlan · Codex",
        "shortDescription": "GPT efforts, your quota & resets.",
        "developerName": "ModelPlans",
        "category": "Productivity",
        "capabilities": [
          "Read"
        ],
        "brandColor": "#df604c",
        "defaultPrompt": [
          "Open the ModelPlan model dashboard."
        ],
        "logo": "./ui/kit/logo.svg"
      }
    }
  },
  "license": "MIT",
  "repository": "https://github.com/modelplan/modelplan"
}
