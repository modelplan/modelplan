        {
          "op": "press",
          "by": "id",
          "value": "settings.size"
        },
        {
          "op": "wait",
          "seconds": 0.6
        },
        {
          "op": "press",
          "by": "title",
          "value": "S"
        },
        {
          "op": "wait",
          "seconds": 2
        },
        {
          "op": "park"
        },
        {
          "op": "wait",
          "seconds": 1
        }
      ],
      "shot": {
        "crop": "window-of:ax:dock.grip.0",
        "window": "window-of:ax:dock.grip.0"
      },
      "checks": [
        {
          "exists": "ax:dock.grip.0"
        }
      ]
    },
