{
  "schemaVersion": 1,
  "steps": [
    {
      "id": "first-run-window",
      "title": "First-run window",
      "expected": "The Set up ModelPlan window lists the synthetic subscriptions (since build 14: one row per tool found, with a checkbox); the widget is visible beside it.",
      "actions": [
        {
          "op": "await",
          "target": "ax:firstRun.done",
          "timeout": 30
        },
        {
          "op": "awaitAbsent",
          "target": "ax:scope.firstRun.looking",
          "timeout": 20
        },
        {
          "op": "park"
        }
      ],
      "shot": {
        "crop": "window-of:ax:firstRun.done",
        "window": "window-of:ax:firstRun.done"
      },
      "checks": [
        {
          "exists": "ax:firstRun.title"
        }
      ]
    },
    {
      "id": "first-run-done",
      "title": "First run finished",
      "expected": "Done closes the window and the widget stays. With the tool chooser (build 14) Done needs one tool ticked; a tool found is ticked by default, so the walk ticks one only when the page asks for it. No hint is due here: v1 hints are for a concealed widget.",
      "requires": [
        "first-run-window"
      ],
      "actions": [
        {
          "op": "press",
          "by": "id",
          "value": "firstRun.login"
        },
        {
          "op": "when",
          "present": "ax:scope.firstRun.pickOne",
          "then": [
            {
              "op": "click",
              "target": "ax^:scope.firstRun.tool."
            },
            {
              "op": "wait",
              "seconds": 0.5
            }
          ]
        },
        {
          "op": "click",
          "target": "ax:firstRun.done"
        },
        {
          "op": "wait",
          "seconds": 1.5
        },
        {
          "op": "park"
        },
        {
          "op": "wait",
          "seconds": 1
        }
      ],
      "shot": {},
      "checks": [
        {
          "absent": "ax:firstRun.done"
        }
      ]
    },
    {
      "id": "widget-found",
      "title": "Widget found and kept out",
      "expected": "A fresh install starts with the widget collapsed (D56, build 14). The walk turns Auto-Collapse off in Settings > Quota Widget (the widget's own menu cannot be reached while it is collapsed) and uses Find Quota Widget to bring it out, so the rest, card and size steps see the whole widget. A build without Find Quota Widget starts expanded and skips this.",
      "actions": [
        {
          "op": "key",
          "name": "escape"
        },
        {
          "op": "click",
          "target": "status-item",
          "button": "right"
        },
        {
          "op": "wait",
          "seconds": 1.2
        },
        {
          "op": "when",
          "present": "ax:status.findQuotaWidget",
          "then": [
            {
              "op": "press",
              "by": "title",
              "value": "Settings…"
            },
            {
              "op": "await",
              "target": "ax:settings.sidebar",
              "timeout": 15
            },
            {
              "op": "click",
              "target": "ax:settings.pane.dock"
            },
            {
              "op": "await",
              "target": "ax:settings.autoHide",
              "timeout": 5
            },
            {
              "op": "when",
              "then": [
                {
                  "op": "press",
                  "by": "id",
                  "value": "settings.autoHide"
                },
                {
                  "op": "wait",
                  "seconds": 0.6
                },
                {
                  "op": "press",
                  "by": "title",
                  "value": "Off"
                },
                {
                  "op": "wait",
                  "seconds": 1.5
                }
              ],
              "equals": {
                "target": "ax:settings.autoHide",
                "value": "On"
              }
            },
            {
              "op": "click",
              "target": "subrole:AXCloseButton"
            },
            {
              "op": "wait",
              "seconds": 1
            },
            {
              "op": "click",
              "target": "status-item",
              "button": "right"
            },
            {
              "op": "wait",
              "seconds": 1.2
            },
            {
              "op": "press",
              "by": "id",
              "value": "status.findQuotaWidget"
            },
            {
              "op": "await",
              "target": "ax^:dock.subscription.",
              "timeout": 10
            }
          ]
        },
        {
          "op": "key",
          "name": "escape"
        },
        {
          "op": "park"
        },
        {
          "op": "wait",
          "seconds": 3
        }
      ],
      "shot": {},
      "checks": [
        {
          "exists": "ax^:dock.subscription."
        },
        {
          "absent": "ax:settings.sidebar"
        }
      ]
    },
    {
      "id": "widget-rest",
      "title": "Widget at rest",
      "expected": "Rings, gauges and percentages at rest. Pointer away from the widget.",
      "prototype": "dock study prototype, rest state",
      "actions": [
        {
          "op": "dismissHints"
        },
        {
          "op": "await",
          "target": "ax^:dock.subscription.",
          "timeout": 20
        },
        {
          "op": "park"
        },
        {
          "op": "wait",
          "seconds": 2
        },
        {
          "op": "mirrorPixels"
        }
      ],
      "shot": {
        "crop": "window-of:ax:dock.grip.0",
        "window": "window-of:ax:dock.grip.0"
      },
      "checks": [
        {
          "exists": "ax^:dock.subscription."
        },
        {
          "nonblank": "window-of:ax:dock.grip.0"
        }
      ]
    },
    {
      "id": "widget-hover",
      "title": "Widget hover and magnify",
      "expected": "The ring under the pointer magnifies; the others stay put.",
      "prototype": "dock study prototype, hover state",
      "requires": [
        "widget-rest"
      ],
      "actions": [
        {
          "op": "hover",
          "target": "ax^:dock.subscription.",
          "seconds": 1.2
        }
      ],
      "shot": {
        "crop": "window-of:ax:dock.grip.0",
        "window": "window-of:ax:dock.grip.0"
      },
      "checks": [
        {
          "exists": "ax^:dock.subscription."
        }
      ]
    },
    {
      "id": "ring-card-map",
      "title": "Card per ring",
      "expected": "Pointing at each painted ring opens that ring's own card. The manifest also records what opens at the frame the app reports.",
      "requires": [
        "widget-rest"
      ],
      "actions": [
        {
          "op": "ringCardMap"
        }
      ],
      "shot": {},
      "checks": []
    },
    {
      "id": "drag-carry",
      "title": "Drag, carried",
      "expected": "While carried the widget follows the pointer; no click-through outline shows.",
      "requires": [
        "widget-rest"
      ],
      "actions": [
        {
          "op": "park"
        },
        {
          "op": "wait",
          "seconds": 1.5
        },
        {
          "op": "assertAbsent",
          "target": "ax^:dock.card."
        },
        {
          "op": "remember",
          "target": "window-of:ax:dock.grip.0"
        },
        {
          "op": "dragStart",
          "target": "ax:dock.grip.0"
        },
        {
          "op": "dragTo",
          "point": [
            0.5,
            0.5
          ],
          "seconds": 1.0
        },
        {
          "op": "wait",
          "seconds": 0.5
        }
      ],
      "shot": {},
      "checks": []
    },
    {
      "id": "drag-snap",
      "title": "Drag and snap",
      "expected": "Released near the left edge, the widget snaps to that edge. No card is open.",
      "requires": [
        "widget-rest"
      ],
      "actions": [
        {
          "op": "dragTo",
          "point": [
            0.04,
            0.5
          ],
          "seconds": 1.0
        },
        {
          "op": "dragEnd"
        },
        {
          "op": "wait",
          "seconds": 1.5
        },
        {
          "op": "park"
        },
        {
          "op": "wait",
          "seconds": 1
        }
      ],
      "shot": {
        "crop": "window-of:ax:dock.grip.0"
      },
      "checks": [
        {
          "moved": "window-of:ax:dock.grip.0"
        },
        {
          "absent": "ax^:dock.card."
        }
      ]
    },
    {
      "id": "widget-size-S",
      "title": "Quota Widget size S",
      "expected": "Settings > Quota Widget size S resizes the widget; the visual comparison reads its window shot against the prototype's S widget. Taken right after the drag-snap, while all five synthetic rings are still there and the widget is docked on the left edge like the prototype.",
