#!/bin/sh
# SPDX-License-Identifier: MIT
# Explicit test-build binary only. This wrapper never compiles or requests TCC.
set -eu
if [ "$#" -lt 2 ] || [ "$1" != "--binary" ]; then
  echo 'usage: pointer_drive --binary <owned-test-build/pointer_drive> --check|--plan <config>|--status-menu-plan <config>' >&2
  exit 64
fi
binary=$2
shift 2
exec "$binary" "$@"
