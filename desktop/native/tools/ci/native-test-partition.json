{
  "schemaVersion": 1,
  "_comment": "Classes listed under headless run on the ordinary self-hosted Mac runner; every other class, including new ones, runs on the GUI runner. A headless class's file may not use window-server APIs and must build every Dock/entry factory with createsNativePanels: false (checked by native_test_partition.py check).",
  "windowServerMarkers": [
    "\\bNSWindow\\s*\\(",
    "\\bNSPanel\\s*\\(",
    "\\bNSApplication\\.shared\\b",
    "\\bNSApp\\b",
    "\\bNSStatusBar\\b",
    "\\bstatusItem\\s*\\(",
    "\\borderFront",
    "\\bmakeKeyAndOrderFront\\b",
    "\\bmakeKey\\s*\\(",
    "\\bsetActivationPolicy\\b",
    "\\bNSScreen\\b",
    "\\bCGEvent",
    "\\bAXUIElement",
    "\\bCGWindowList",
    "\\bCGDisplay",
    "\\bNSWorkspace\\b",
    "\\brunModal\\b",
    "\\bisVisible\\b",
    "\\bocclusionState\\b",
    "createsNativePanels\\s*:\\s*true"
  ],
  "panelFactories": [
    "\\bEngineRowsEntry\\.make\\(",
    "\\bCommunityCockpitApplicationFactory\\.make\\(",
    "\\bProductionDockFactory\\.community\\(",
    "\\bEngineDockMenuApplication(?:\\.make)?\\(",
    "\\bEngineDockMenuComposition\\(",
    "\\bStaticDockPreviewHost\\("
  ],
