{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Model Plan",
  "version": "0.1.0",
  "identifier": "ai.modelplan.desktop",
  "build": {
    "frontendDist": "../app/dist",
    "beforeDevCommand": "npm run build",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "popover",
        "title": "Model Plan",
        "url": "index.html",
        "width": 380,
        "height": 580,
        "visible": false,
        "decorations": false,
        "resizable": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Which model and effort fit, with your quota",
    "copyright": "MIT License. \"Model Plan\" and its logo are trademarks; see desktop/README.md.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0",
      "signingIdentity": "-"
    }
  }
}
